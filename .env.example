DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=your_jwt_secret_here
PORT=8080
NODE_ENV=production

# Railway public URL (used for QR codes and email links)
RAILWAY_BASE_URL=https://your-service.up.railway.app
RAILWAY_PUBLIC_DOMAIN=your-service.up.railway.app

# Activations admin auth
ACTIVATIONS_ADMIN_PASS=your-admin-password
ACTIVATIONS_ADMIN_SECRET=your-jwt-secret

# Cloudinary (booth photo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (vendor confirmation emails)
RESEND_API_KEY=
RESEND_FROM=booths@yourdomain.com
