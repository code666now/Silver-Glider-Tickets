DATABASE_URL=postgresql://admin:admin@host:5432/silver-glider
JWT_SECRET=iP24tm0/Ae5xdcPRxWRwp7VbZPwlm5dqmL0mNBKwlcE
PORT=3000
NODE_ENV=development

# Email (Resend) — si falta RESEND_API_KEY el envío se omite con un log
RESEND_API_KEY=
RESEND_FROM=tickets@silverglider.com

# Reintento de correos fallidos (lib/emailRetry.js). Requiere RESEND_API_KEY.
EMAIL_RETRY_DELAY_MINUTES=5
EMAIL_RETRY_MAX_ATTEMPTS=5
EMAIL_RETRY_TICK_MS=60000

# URL base de ESTE microservicio (no del principal): el email enlaza a APP_URL/wallet.
# Sin barra final.
APP_URL=http://localhost:3000

# Auth servicio-a-servicio (mismo valor en el backend principal). Header: x-api-key
SERVICE_API_KEY=

# URL base del backend principal (sin barra final). Usada para el pull-on-import:
# si llega una orden con un external_event_id no mapeado, el micro jala el evento de
# GET {PRINCIPAL_URL}/api/eventos/:id y lo auto-crea en sg_events.
PRINCIPAL_URL=https://<backend-principal-en-render>

# Lista blanca CORS (orígenes separados por coma; vacío = permitir todos)
CORS_ORIGINS=

# SSO de publicadores desde el backend principal (door list + descarga CSV/PDF).
# SSO_SHARED_SECRET: mismo valor que TICKETING_SSO_SECRET del principal; distinto de
# JWT_SECRET (aquí y allá). Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SSO_SHARED_SECRET=
# Roles del principal que pueden entrar. Quitar uno aquí corta también las sesiones abiertas.
SSO_ALLOWED_ROLES=artist,partner,promoter,venue
# Duración de la sesión local del publicador, en horas.
SSO_SESSION_HOURS=4
# URL pública del FRONT principal (sin barra final). Es una variable de BUILD de Astro:
# debe estar definida antes de `npm run build` (en Railway, antes de desplegar). Con ella,
# el login de /doorlist muestra "Entrar con Silver Glider" -> {PUBLIC_PRINCIPAL_URL}/doorlist-access.
# Vacía: no se muestra el botón.
PUBLIC_PRINCIPAL_URL=
