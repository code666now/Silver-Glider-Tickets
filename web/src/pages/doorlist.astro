---
// Door list: lista de asistentes por evento, check-in manual (solo personal local) y
// descarga CSV/PDF. Página estática; los datos llegan por /api en el navegador
// (src/scripts/doorlist.ts), por eso no hay directivas client:* ni SSR.
import OpsLayout from '../layouts/OpsLayout.astro';
import LoginCard from '../components/LoginCard.astro';
import ExportDialog from '../components/ExportDialog.astro';
---

<OpsLayout title="Door List" section="Door List">
  <div slot="header-actions" class="header-actions" data-when="authed" hidden>
    <span class="who" data-who></span>
    <button class="btn-ghost" type="button" data-logout>Log out</button>
  </div>

  <p class="boot" data-boot>Loading…</p>
  <p class="banner" data-banner role="alert" hidden></p>

  <LoginCard id="login" />

  <section data-when="authed" hidden>
    <div class="toolbar">
      <label class="sr-only" for="event-select">Event</label>
      <select id="event-select" data-event-select>
        <option value="">Select event…</option>
      </select>
      <label class="sr-only" for="search-input">Search</label>
      <input id="search-input" type="search" placeholder="Search name, email, phone or confirmation #" data-search disabled />
      <div class="toolbar-actions">
        <button class="btn" type="button" data-open-export disabled>Download</button>
        <button class="btn" type="button" data-print disabled>Print</button>
      </div>
    </div>

    <div class="stats" data-stats hidden>
      <div class="stat"><span class="label">Orders</span><span class="value" data-stat="orders">0</span></div>
      <div class="stat"><span class="label">Tickets</span><span class="value" data-stat="tickets">0</span></div>
      <div class="stat"><span class="label">Checked in</span><span class="value ok" data-stat="checked">0</span></div>
      <div class="stat"><span class="label">Remaining</span><span class="value warn" data-stat="remaining">0</span></div>
      <div class="progress" aria-hidden="true"><span data-progress></span></div>
    </div>

    <p class="empty" data-empty>Select an event to view the door list.</p>

    <div class="table-wrap" data-table-wrap hidden>
      <table>
        <thead>
          <tr>
            <th scope="col">Last name</th>
            <th scope="col">First name</th>
            <th scope="col" class="num">Qty</th>
            <th scope="col">Type</th>
            <th scope="col">Confirmation #</th>
            <th scope="col">Email</th>
            <th scope="col">Phone</th>
            <th scope="col">Status</th>
            <th scope="col" data-staff-only><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody data-tbody></tbody>
      </table>
    </div>
  </section>

  <ExportDialog />
</OpsLayout>

<script>
  import '../scripts/doorlist';
</script>

<style>
  .header-actions { display: flex; gap: 12px; align-items: center; }
  .who { font-size: 12px; color: var(--text-muted); }
  .boot { color: var(--text-faint); text-align: center; padding: 60px 0; }
  .banner {
    background: #2a1414; border: 1px solid #4a2020; color: #ffb3b3;
    padding: 10px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 16px;
  }

  .toolbar { display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; align-items: center; }
  #event-select { min-width: 260px; font-size: 14px; }
  #search-input { flex: 1; min-width: 220px; font-size: 14px; }
  .toolbar-actions { display: flex; gap: 8px; }

  .stats { display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; position: relative; padding-bottom: 14px; }
  .stat {
    background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
    padding: 12px 18px; min-width: 120px; display: flex; flex-direction: column; gap: 4px;
  }
  .label { font-size: 11px; color: var(--text-faint); text-transform: uppercase; letter-spacing: 0.06em; }
  .value { font-size: 24px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .value.ok { color: var(--ok); }
  .value.warn { color: var(--warn); }
  .progress { position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: var(--surface-2); border-radius: 4px; overflow: hidden; }
  .progress span { display: block; height: 100%; width: 0; background: var(--ok); transition: width 0.3s ease; }

  .empty { text-align: center; color: var(--text-faint); padding: 60px 0; font-size: 14px; }

  .table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  thead th {
    text-align: left; padding: 10px 14px; font-size: 11px; color: var(--text-faint);
    text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 1px solid var(--border);
    background: var(--surface); white-space: nowrap;
  }
  .num { text-align: right; }

  /* Filas generadas por el script: fuera del alcance del CSS con scope. */
  :global(.door-row) { border-bottom: 1px solid #161616; }
  :global(.door-row:hover) { background: var(--surface); }
  :global(.door-row td) { padding: 11px 14px; vertical-align: middle; }
  :global(.door-row .last) { font-weight: 600; }
  :global(.door-row .num) { text-align: right; font-variant-numeric: tabular-nums; }
  :global(.door-row .muted) { color: var(--text-muted); font-size: 12px; }
  :global(.door-row .mono) { font-family: var(--mono); font-size: 13px; }
  :global(.badge) {
    font-size: 11px; padding: 3px 9px; border-radius: 20px; font-weight: 600;
    letter-spacing: 0.04em; text-transform: uppercase; white-space: nowrap;
    border: 1px solid var(--border); color: var(--text-faint); background: var(--surface-2);
  }
  :global(.badge.in) { background: #141a2a; color: var(--info); border-color: #2a2a4a; }
  :global(.badge.partial) { background: #2a2414; color: var(--warn); border-color: #4a3f20; }
  :global(.checkin-btn) {
    background: var(--ok); color: #ffffff; border: none; padding: 6px 14px;
    border-radius: 6px; font-size: 12px; font-weight: 600;
  }

  @media print {
    :global(body) { background: #ffffff; color: #000000; }
    .toolbar, .stats, .banner, [data-staff-only], :global(.checkin-btn), :global(.actions-cell) { display: none !important; }
    .table-wrap { border: none; }
    table { font-size: 12px; }
    thead th { color: #000000; background: none; border-bottom: 2px solid #000000; }
    :global(.door-row) { border-bottom: 1px solid #cccccc; }
    :global(.door-row .muted) { color: #333333; }
    :global(.badge) { background: none !important; color: #000000 !important; border-color: #000000 !important; }
  }
</style>
